# ---------------------------------------------------------------------------
# Every value here is optional. With no environment at all, the app runs a
# single-server test against itself and stores results in a SQLite file under
# ./data — which is the whole configuration most intranet installs need.
#
# Except where noted, these are read per request, so a restart is enough to
# apply a change. No rebuild is required.
# ---------------------------------------------------------------------------

# --- Identity --------------------------------------------------------------
SPEEDTEST_BRAND_NAME=LibreSpeed
SPEEDTEST_TAGLINE=Speed Test

# --- Networking ------------------------------------------------------------
PORT=3000
HOSTNAME=0.0.0.0

# Set to 1 ONLY when a reverse proxy you control terminates connections and
# sets X-Real-IP / X-Forwarded-For. Left off, those headers are stripped and
# the client address is taken from the TCP peer, which a client cannot forge.
# Turning it on without a proxy in front lets any visitor choose the address
# recorded against their own result.
TRUST_PROXY=0

# Serve from a subdirectory, e.g. /speedtest. BUILD-TIME ONLY: Next bakes this
# into asset URLs while compiling, so changing it needs a rebuild.
# NEXT_PUBLIC_BASE_PATH=/speedtest

# --- Telemetry and sharing -------------------------------------------------
# Off means results are never stored, and there is nothing to share.
SPEEDTEST_TELEMETRY=1
# basic = results only | full = results and timings | debug = adds the worker log
SPEEDTEST_TELEMETRY_LEVEL=basic
SPEEDTEST_SHARE=1

# Replace stored addresses and hostnames with placeholders. Useful where
# recording who ran a test is a problem in itself.
SPEEDTEST_REDACT_IP=0

# Share ids are scrambled so results cannot be enumerated by counting upward.
# Set 0 only if you want plain row ids in URLs.
SPEEDTEST_OBFUSCATE_IDS=1
# Fix the scramble key explicitly. Required if you run more than one instance
# against one database, or existing share links will not resolve on all of them.
# Otherwise it is generated once and kept in the data directory.
# SPEEDTEST_ID_SALT=0x1a2b3c4d

# --- Storage ---------------------------------------------------------------
# sqlite (default) | postgres | mysql
SPEEDTEST_DB_TYPE=sqlite
# Writable directory for the SQLite file and the generated id salt.
SPEEDTEST_DATA_DIR=./data
# SPEEDTEST_DB_PATH=./data/telemetry.db

# For postgres/mysql, either a URL...
# DATABASE_URL=postgres://user:password@host:5432/speedtest_telemetry
# ...or the parts:
# SPEEDTEST_DB_HOST=localhost
# SPEEDTEST_DB_PORT=5432
# SPEEDTEST_DB_USER=speedtest
# SPEEDTEST_DB_PASSWORD=
# SPEEDTEST_DB_NAME=speedtest_telemetry

# --- Client identification -------------------------------------------------
# Resolve the ISP behind a public address using the bundled offline database.
# Purely local; no lookup service is ever contacted.
SPEEDTEST_ISP_INFO=1
# SPEEDTEST_GEOIP_DB=./assets/geoip/country_asn.mmdb

# --- Measurement parameters ------------------------------------------------
# D=download, U=upload, P=ping+jitter, I=client IP, _=one second pause.
SPEEDTEST_ORDER=I_P_D_U
SPEEDTEST_DL_DURATION=15
SPEEDTEST_UL_DURATION=15
# Finish early once the link is clearly faster than the test needs.
SPEEDTEST_AUTO_DURATION=1
# Seconds discarded at the start of each phase while buffers fill.
SPEEDTEST_DL_GRACE=1.5
SPEEDTEST_UL_GRACE=3
SPEEDTEST_PING_COUNT=10
SPEEDTEST_DL_STREAMS=6
SPEEDTEST_UL_STREAMS=3
# MiB per download request.
SPEEDTEST_CHUNK_SIZE=100
# Scales measured bytes to account for TCP/IP framing.
SPEEDTEST_OVERHEAD=1.06

# --- Multiple measurement servers ------------------------------------------
# Inline JSON, or a path to a JSON file. Omit for single-server mode.
# SPEEDTEST_SERVERS=./servers.example.json
