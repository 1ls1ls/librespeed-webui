{
  "name": "librespeed-webui",
  "version": "1.0.0",
  "private": true,
  "description": "A self-hosted speed test with an Ookla Speedtest look and feel, built on Next.js. Uses the LibreSpeed measurement engine with a TypeScript telemetry and result-sharing backend. No CDNs, no external fonts, no third-party requests.",
  "license": "LGPL-3.0-or-later",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "maxmind": "^4.3.24",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "optionalDependencies": {
    "mysql2": "^3.12.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
